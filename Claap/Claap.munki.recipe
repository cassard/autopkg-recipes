<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Wraps the verified Claap app in a disk image and imports it into Munki.

Claap does not ship a universal build. Defaults to Apple Silicon. For Intel, set DOWNLOAD_ARCH to "x64" and SUPPORTED_ARCH to "x86_64" in an override.</string>
    <key>Comment</key>
    <string>Set Input.pkginfo.catalogs in an AutoPkg override to choose catalogs. When no catalogs are specified, makepkginfo defaults to testing.</string>
    <key>Identifier</key>
    <string>com.github.cassard.munki.Claap</string>
    <key>ParentRecipe</key>
    <string>com.github.cassard.download.Claap</string>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>Input</key>
    <dict>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>SUPPORTED_ARCH</key>
        <string>arm64</string>
        <key>pkginfo</key>
        <dict>
            <key>description</key>
            <string>Video messaging and screen recording for asynchronous team communication.</string>
            <key>developer</key>
            <string>Claap</string>
            <key>display_name</key>
            <string>Claap</string>
            <key>minimum_os_version</key>
            <string>12.0</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>supported_architectures</key>
            <array>
                <string>%SUPPORTED_ARCH%</string>
            </array>
        </dict>
    </dict>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>DmgCreator</string>
            <key>Arguments</key>
            <dict>
                <key>dmg_root</key>
                <string>%RECIPE_CACHE_DIR%/%NAME%</string>
                <key>dmg_path</key>
                <string>%RECIPE_CACHE_DIR%/%NAME%-%version%-%SUPPORTED_ARCH%.dmg</string>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%dmg_path%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>

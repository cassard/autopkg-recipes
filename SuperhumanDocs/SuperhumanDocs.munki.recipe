<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Imports the verified universal Superhuman Docs disk image into Munki.</string>
    <key>Comment</key>
    <string>Set Input.pkginfo.catalogs in an AutoPkg override to choose catalogs. When no catalogs are specified, makepkginfo defaults to testing.</string>
    <key>Identifier</key>
    <string>com.github.cassard.munki.SuperhumanDocs</string>
    <key>ParentRecipe</key>
    <string>com.github.cassard.download.SuperhumanDocs</string>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>Input</key>
    <dict>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>pkginfo</key>
        <dict>
            <key>description</key>
            <string>Collaborative workspace for documents, tables, and team workflows.</string>
            <key>developer</key>
            <string>Grammarly, Inc</string>
            <key>display_name</key>
            <string>Superhuman Docs</string>
            <key>name</key>
            <string>Superhuman Docs</string>
        </dict>
    </dict>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
                <key>additional_makepkginfo_options</key>
                <array>
                    <string>--item</string>
                    <string>%APP_FILENAME%</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
